# Environment files with secrets
.env
.env.local
.env.production
.env.development
*.env

# SSL certificates
config/nginx/ssl/*.pem
config/nginx/ssl/*.key
config/nginx/ssl/*.crt

# Backup files
*.sql
# ...except migrations. These are the schema: DBAL's create-table template
# emits columns only, so foreign keys, index changes and dropped columns
# live here and nowhere else. Ignoring them loses the database's shape.
!migrations/*.sql
*.dump
backups/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Playwright CLI session dumps (timestamped scratch output, not config)
.playwright-cli/

# Python bytecode
__pycache__/
*.pyc
